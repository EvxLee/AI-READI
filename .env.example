# Copy to .env and fill in. .env is gitignored — never commit credentials.

AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=your_account_name;AccountKey=your_account_key;EndpointSuffix=core.windows.net"

# Canonical container and study ID for AI-READI v3.0.0.
# These are the defaults in src/aireadi/constants.py; set them here only to
# override. The EDA-era value 00b62456-0b93-4975-a992-42ba6a50ed5c is WRONG.
AZURE_CONTAINER_NAME="aireadi-container"
AZURE_STUDY_ID="1438dd73-c4cb-48b8-8fa8-c858771207c3"

# Optional: move the local blob cache off the repo disk.
# AIREADI_CACHE_DIR="/path/to/cache"
