# ── Participant-level data: NEVER commit ────────────────────────────────
# AI-READI is controlled-access under a data use agreement. Nothing keyed by
# person_id belongs in this repository -- not raw files, not derived tables,
# not notebook outputs.
data/*
!data/.gitkeep

# Belt and braces: catch person-level tables wherever they land.
*_per_person.csv
*_participants.csv
full_*.csv
*_full.csv

# ── Personal planning documents (local use only) ────────────────────────
PROJECT_CONTEXT.md
repo_reorg_plan.md
papers/*/PLAN.md
papers/*/EXPERIMENTS.md

# ── Secrets ─────────────────────────────────────────────────────────────
.env
*.key
key.txt
config/secrets.py

# ── Python ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
*.egg-info/
.eggs/
dist/
build/

# ── Jupyter ─────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── IDE / OS ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
